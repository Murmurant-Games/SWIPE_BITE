
== print_name(character)

    { character:
        -normie:
            ~ normie_name()
            
        -innocent:
            ~ innocent_name()
            
        -hunter:
            ~ hunter_name()
            
        -another_hunter:
            ~hunter_name()
        
        -experienced_hunter:
            ~hunter_name()
                      
        -thrall:
            ~ thrall_name()
                 
        -douche:
            ~ douche_name()
            
        - gym_bro: // MORE JUICE!
            ~ gym_bro_name()
           
        - cryptid:
            ~ cryptid_name()
           
        - former_flame:
            ~ former_flame_name()
          
        - goth:
            ~ goth_name()
            
        - cheater:
            ~ cheater_name()
        
        - else:
            MISSING
           
    }
    <> [title]
    
    // GENDER
    { character:
        -normie:
            m
            
        -innocent:
            f
            
        -hunter:
            m
                      
        -thrall:
            m
                 
        -douche:
            m
            
        - gym_bro: // MORE JUICE!
            m
           
        - cryptid:
            nb
           
        - former_flame:
            nb
          
        - goth:
            nb
            
        - cheater:
            m
        - else:
            MISSING
           
    }    
    <> [pronoun]
    ->->

    
