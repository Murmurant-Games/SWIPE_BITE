== print_bio(character)
    
    { character:
        -normie:
            ~ normie_bio()
            
        -innocent:
            ~ innocent_bio()
            
        -hunter:
            ~ hunter_bio()
                      
        -thrall:
            ~ thrall_bio()
                 
        -douche:
            ~ douche_bio()
            
        - gym_bro: // MORE JUICE!
            ~ gym_bro_bio()
           
        - cryptid:
            ~ cryptid_bio()
           
        - former_flame:
            ~ former_flame_bio()
          
        - goth:
            ~ goth_bio()
            
        - cheater:
            ~ cheater_bio()
        
        - else:
            MISSING           
    }
    <> [bio]
    ->->

    
